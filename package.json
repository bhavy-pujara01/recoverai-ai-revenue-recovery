{
  "name": "recoverai-platform",
  "version": "1.0.0",
  "description": "RecoverAI — Intelligent Payment Revenue Recovery Platform",
  "main": "api/index.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npx prisma generate --schema=backend/prisma/schema.prisma && npm --prefix frontend run build",
    "prisma:generate": "npx prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=backend/prisma/schema.prisma",
    "prisma:seed": "node backend/prisma/seed.js",
    "test": "node --test tests/unit/recoveryEngine.test.js tests/integration/api.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
