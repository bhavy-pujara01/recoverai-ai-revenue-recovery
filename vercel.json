{
  "version": 2,
  "buildCommand": "npx prisma generate --schema=backend/prisma/schema.prisma && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
